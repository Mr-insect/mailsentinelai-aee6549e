# --- MailSentinel AI backend (server-side only; never commit real keys) ---
# Copy to backend/.env (git-ignored) or project .env for local dev.

# AI verdict provider (OpenAI). Optional; without it the backend still
# returns deterministic + live-intel results labelled accordingly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Live threat intelligence (all optional; each degrades gracefully).
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Geolocation: optional MaxMind GeoLite2 databases (paths on the server).
# Without them, the ip-api fallback is used (country-level, no key).
# MAXMIND_CITY_DB=C:\data\GeoLite2-City.mmdb
# MAXMIND_ASN_DB=C:\data\GeoLite2-ASN.mmdb

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
MAX_EML_BYTES=8388608
MAX_ATTACHMENT_BYTES=8388608
EXTERNAL_TIMEOUT_S=12
AI_TIMEOUT_S=45
AI_MAX_BODY_CHARS=4000
AI_MAX_URLS=10
MAX_URLS=15
MAX_IPS=15
MAX_DOMAINS=15
MAX_ATTACHMENTS=5
# Set true when deploying publicly behind a reverse proxy with rate limiting.
ENABLE_RATE_LIMITING=false
